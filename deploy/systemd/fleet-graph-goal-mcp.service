# systemd *user* unit for the standalone goal-driven MCP surface.
#
# The goal-driven family (goal_enroll / goal-open / briefing) lives on its own
# surface (`fleet-graph goal serve`, :5611), not on the dev-dispatch MCP --
# the goal-driven MCP is goal-driven, the dd face is pure dev-dispatch
# (2026-08-31 用户拍板).
#
# Template only: shipped in the repo, deliberately not enabled or installed by
# any script here -- deployment is a supervision-plane decision (same
# convention and comment discipline as fleet-graph-dd-mcp.service).
#
# `goal serve` is a real subcommand, checked by tests/test_deploy_unit.py the
# same way the dd-mcp unit is: an invented subcommand plus Restart=always is a
# silent crash loop, not a visible failure.
#
# Fail-fast root binding: `goal serve` refuses to start without a bound
# --work-folder-root (or FLEET_GRAPH_WORK_FOLDER_ROOT) -- a goal MCP with no
# goal-folder root would only report GOAL_ENROLL_SOURCE_UNBOUND on first use.
# ExecStart therefore passes --work-folder-root explicitly; the site value is
# filled in by the deployer (this repo never hardcodes a host path).
#
# The enrollment queue lives in an independent queue home (default
# /data/fleet-graph/goal/), separate from the work-folder-root, so goal
# enrollment never pollutes the governance warehouse that owns goal folders.
# The state read-model's /v1/enrollments defaults to this same home.
#
# Port 5611 was bind-tested free on the fleet host (2026-08-31) and collides
# with none of the reserved ports (5606/7455/7460/8113/5601/5602/5605/5608/
# 7490/9090/9093/3300/8101/3002). The service itself refuses to start when the
# port is taken (see fleet_graph.goal.service.port_is_available).
[Unit]
Description=fleet-graph goal-driven MCP surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/apps/fleet-graph/current
ExecStart=/data/apps/fleet-graph/current/.venv/bin/fleet-graph goal serve \
    --host 127.0.0.1 --port 5611 \
    --work-folder-root <work-folder-root> \
    --goal-queue-home /data/fleet-graph/goal
Restart=always
RestartSec=5
TimeoutStopSec=30
# Credentials are env-only; never commit a token into this unit. The optional
# marker (`-` after the `=`) matches fleet-graphd.service: a missing env file
# must not be an unexplained start failure.
EnvironmentFile=-%h/.config/fleet-graph/env
# Same PATH as fleet-graphd.service, for the same reason: the goal-enroll
# liveness probe executes the candidate line's declared acceptance argv
# through the same process environment.
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.opencode/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[Install]
WantedBy=default.target
