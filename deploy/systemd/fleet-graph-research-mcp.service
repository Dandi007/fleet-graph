# systemd *user* unit for the standalone research MCP surface.
#
# The research family (research_run) lives on its own surface
# (`fleet-graph research serve`, :5612), not on the dev-dispatch or goal MCP --
# research is its own surface (2026-08-31 R6: 三面统一路由，MCP tool 面).
#
# Template only: shipped in the repo, deliberately not enabled or installed by
# any script here -- deployment is a supervision-plane decision (same
# convention and comment discipline as fleet-graph-goal-mcp.service).
#
# `research serve` is a real subcommand, checked by tests/test_deploy_unit.py
# the same way the goal-mcp unit is: an invented subcommand plus Restart=always
# is a silent crash loop, not a visible failure.
#
# Fail-fast wiki-root binding: `research serve` refuses to start without a
# bound --wiki-root (or FLEET_GRAPH_WIKI_ROOT) -- a research MCP with no wiki
# root would misplace its reports on first use. ExecStart therefore passes
# --wiki-root explicitly; the site value is filled in by the deployer (this
# repo never hardcodes a host path).
#
# Port 5612 was bind-tested free on the fleet host (2026-08-31) and collides
# with none of the reserved ports (5606/7455/7460/8113/5601/5602/5605/5608/
# 7490/9090/9093/3300/8101/3002/5610/5611/7494). The service itself refuses to
# start when the port is taken (see fleet_graph.research_mcp.port_is_available).
[Unit]
Description=fleet-graph research MCP surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/apps/fleet-graph/current
ExecStart=/data/apps/fleet-graph/current/.venv/bin/fleet-graph research serve \
    --host 127.0.0.1 --port 5612 \
    --wiki-root <wiki-root>
Restart=always
RestartSec=5
TimeoutStopSec=30
# Credentials are env-only; never commit a token into this unit. The optional
# marker (`-` after the `=`) matches fleet-graphd.service: a missing env file
# must not be an unexplained start failure.
EnvironmentFile=-%h/.config/fleet-graph/env
# Same PATH as fleet-graphd.service, for the same reason: the research entry
# may execute agent-run through the same process environment.
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.opencode/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[Install]
WantedBy=default.target
