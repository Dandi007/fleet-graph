# systemd *user* unit for the dev-dispatch MCP surface.
#
# The service IS the control plane (supervision ruling, 2026-08-27): the 7
# real tools drive fleet_graph.dd.control_plane in-process. There is no
# separate graph-API tier behind this unit any more.
#
# Template only: shipped in the repo, deliberately not enabled or installed by
# any script here -- deployment is a supervision-plane decision (wf-a08949).
#
# `dd serve` is a real subcommand, checked by tests/test_deploy_unit.py the
# same way fleet-graphd.service is: an invented subcommand plus Restart=always
# is a silent crash loop, not a visible failure.
#
# Port 5610 was bind-tested free on the fleet host (2026-08-27) and collides
# with none of the reserved ports (5606/7455/7460/8113/5601/5602/5605/5608/
# 7490/9090/9093/3300/8101/3002/5611). The service itself refuses to start when
# the port is taken (see fleet_graph.dd.service.port_is_available). 5611 is the
# goal-driven MCP surface's own port (see fleet-graph-goal-mcp.service).
[Unit]
Description=fleet-graph dev-dispatch MCP surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/apps/fleet-graph/current
# 2026-09-02 监督面裁决：撤掉 implement 阶段的 flash 模型覆盖，回落 role registry
# 出厂座位 deepseek-v4-pro（经 agent-run chain 解析到网关腿）；两段 review 高智能
# 走 deepseek-v4-pro。
ExecStart=/data/apps/fleet-graph/current/.venv/bin/fleet-graph dd serve \
    --host 127.0.0.1 --port 5610 \
    --stage-model continuous_review=deepseek-v4-pro \
    --stage-model final_review=deepseek-v4-pro
Restart=always
RestartSec=5
TimeoutStopSec=30
# Credentials are env-only; never commit a token into this unit. The optional
# marker (`-` after the `=`) matches fleet-graphd.service: a missing env file
# must not be an unexplained start failure.
EnvironmentFile=-%h/.config/fleet-graph/env
# Same PATH as fleet-graphd.service, for the same reason: the control plane
# hands its own PATH to every transient dd unit it launches, and those units
# exec `agent-run` -- a bun script. Under the systemd user manager the default
# PATH has no ~/.bun/bin, so without this line every implement dispatch dies
# at `env: 'bun': No such file or directory` before the agent even starts
# (observed live on dev-fg-4628ef887564, three runs "ended lost").
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.opencode/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# cost-observability is turned on from the site-config env file above:
# FLEET_GRAPH_COST_OBS_DIR (the node_exporter textfile directory, see
# deploy/prometheus/cost-observability.yml) and FLEET_GRAPH_MANAGEMENT_COST
# are forwarded to every launched dd run by the control plane's whitelist, so
# setting them in ~/.config/fleet-graph/env is what switches collection on --
# nothing here hardcodes a path that belongs to the operator's host.
[Install]
WantedBy=default.target
