# 外门服务模板；站点安装后由 release.sh --activate 核验版本。
[Unit]
Description=fleet-graph outer-gate MCP surface (R5: state read x4 / supervisor write x4 / note_publish)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/apps/fleet-graph/current
ExecStart=/data/apps/fleet-graph/current/.venv/bin/fleet-graph outer-gate serve \
    --host 127.0.0.1 --port 5617 \
    --run-root /data/fleet-graph/runs \
    --dd-root /data/fleet-graph/dd \
    --lines-config /data/apps/fleet-graph/current/config/ronin-lines.json
Restart=always
RestartSec=5
TimeoutStopSec=30
EnvironmentFile=-%h/.config/fleet-graph/env
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.opencode/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[Install]
WantedBy=default.target
