{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev-dispatch/contracts/review-handoff-receipt.schema.json",
  "title": "dev-dispatch.attempt-context/v1 ReviewHandoffReceipt",
  "description": "Controller receipt for a materialized Review commit RC<n>/RF<n>. input_commit must equal subject_commit; the materializer creates output_commit with subject_commit as its direct parent, changing only the reserved .dev-dispatch/ namespace.",
  "type": "object",
  "required": [
    "contract_version",
    "development_id",
    "attempt_id",
    "review_id",
    "review_phase",
    "input_commit",
    "subject_commit",
    "implementation_subject_commit",
    "output_commit",
    "verdict",
    "review_artifact",
    "feedback_index",
    "parent_handoff_receipt_digest",
    "implementation_handoff_receipt_digest",
    "reviewer_job_id",
    "materialization_intent_id"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"$ref": "attempt-context.schema.json#/$defs/contract_version"},
    "development_id": {"$ref": "attempt-context.schema.json#/$defs/nonempty_string"},
    "attempt_id": {"$ref": "attempt-context.schema.json#/$defs/nonempty_string"},
    "review_id": {"$ref": "attempt-context.schema.json#/$defs/nonempty_string"},
    "review_phase": {"$ref": "attempt-context.schema.json#/$defs/review_phase"},
    "input_commit": {"$ref": "attempt-context.schema.json#/$defs/full_commit"},
    "subject_commit": {"$ref": "attempt-context.schema.json#/$defs/full_commit"},
    "implementation_subject_commit": {"$ref": "attempt-context.schema.json#/$defs/full_commit"},
    "output_commit": {"$ref": "attempt-context.schema.json#/$defs/full_commit"},
    "verdict": {"$ref": "attempt-context.schema.json#/$defs/verdict"},
    "review_artifact": {"$ref": "attempt-context.schema.json#/$defs/review_artifact_ref"},
    "feedback_index": {"$ref": "attempt-context.schema.json#/$defs/review_feedback_index_ref"},
    "parent_handoff_receipt_digest": {"$ref": "attempt-context.schema.json#/$defs/sha256_digest"},
    "implementation_handoff_receipt_digest": {"$ref": "attempt-context.schema.json#/$defs/sha256_digest"},
    "reviewer_job_id": {"$ref": "attempt-context.schema.json#/$defs/nonempty_string"},
    "materialization_intent_id": {"$ref": "attempt-context.schema.json#/$defs/nonempty_string"}
  }
}
