{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev-dispatch/contracts/stage-artifacts.schema.json",
  "title": "Stage Artifact Contract",
  "type": "object",
  "required": [
    "contract_version",
    "artifact_kinds",
    "transition_receipts",
    "transport_records",
    "stages"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact_kind": {
      "enum": [
        "spec",
        "product_code",
        "run_config",
        "implementation_evidence",
        "continuous_verdict",
        "final_verdict",
        "feedback",
        "acceptance_result",
        "gate_decision",
        "merge_result",
        "attempt_context_development",
        "attempt_context_spec",
        "attempt_context_spec_manifest",
        "attempt_context_feedback_index",
        "attempt_context_implement_handoff",
        "attempt_context_review"
      ]
    },
    "protocol_artifacts": {
      "type": "object",
      "required": ["dev-dispatch.attempt-context/v1"],
      "additionalProperties": false,
      "properties": {
        "dev-dispatch.attempt-context/v1": {
          "type": "object",
          "required": ["required", "produced"],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "attempt_context_development",
                  "attempt_context_spec",
                  "attempt_context_spec_manifest",
                  "attempt_context_feedback_index",
                  "attempt_context_implement_handoff",
                  "attempt_context_review"
                ]
              },
              "uniqueItems": true
            },
            "produced": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "attempt_context_development",
                  "attempt_context_spec",
                  "attempt_context_spec_manifest",
                  "attempt_context_feedback_index",
                  "attempt_context_implement_handoff",
                  "attempt_context_review"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "properties": {
    "contract_version": {"const": 2},
    "artifact_kinds": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "spec",
        "product_code",
        "run_config",
        "implementation_evidence",
        "continuous_verdict",
        "final_verdict",
        "feedback",
        "acceptance_result",
        "gate_decision",
        "merge_result",
        "attempt_context_development",
        "attempt_context_spec",
        "attempt_context_spec_manifest",
        "attempt_context_feedback_index",
        "attempt_context_implement_handoff",
        "attempt_context_review"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "path_pattern": {"type": "string", "minLength": 1},
          "required_fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "anyOf": [
                {"const": "non-empty-string"},
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "transition_receipts": {
      "type": "object",
      "required": ["implement", "continuous_review", "final_review"],
      "additionalProperties": false,
      "properties": {
        "implement": {
          "type": "object",
          "required": ["materialized", "schema", "output_commit_field"],
          "additionalProperties": false,
          "properties": {
            "materialized": {"const": true},
            "schema": {
              "const": "contracts/implement-handoff-receipt.schema.json"
            },
            "output_commit_field": {"const": "output_commit"}
          }
        },
        "continuous_review": {
          "type": "object",
          "required": [
            "materialized",
            "schema",
            "review_phase",
            "output_commit_field"
          ],
          "additionalProperties": false,
          "properties": {
            "materialized": {"const": true},
            "schema": {
              "const": "contracts/review-handoff-receipt.schema.json"
            },
            "review_phase": {"const": "continuous"},
            "output_commit_field": {"const": "output_commit"}
          }
        },
        "final_review": {
          "type": "object",
          "required": [
            "materialized",
            "schema",
            "review_phase",
            "output_commit_field"
          ],
          "additionalProperties": false,
          "properties": {
            "materialized": {"const": true},
            "schema": {
              "const": "contracts/review-handoff-receipt.schema.json"
            },
            "review_phase": {"const": "final"},
            "output_commit_field": {"const": "output_commit"}
          }
        }
      }
    },
    "transport_records": {
      "type": "object",
      "required": ["review_stage_failure"],
      "additionalProperties": false,
      "properties": {
        "review_stage_failure": {
          "type": "object",
          "required": [
            "owner_node",
            "route",
            "schema",
            "status",
            "terminal",
            "stages"
          ],
          "additionalProperties": false,
          "properties": {
            "owner_node": {"const": "deterministic_seal"},
            "route": {"const": "stage_output"},
            "schema": {"const": "contracts/failed-record.schema.json"},
            "status": {"const": "failed"},
            "terminal": {"const": true},
            "stages": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "enum": ["continuous_review", "final_review", "implement"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "configure",
          "implement",
          "continuous_review",
          "final_review",
          "acceptance",
          "human_gate",
          "merger"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": ["required", "produced"],
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifact_kind"},
            "uniqueItems": true
          },
          "produced": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifact_kind"},
            "uniqueItems": true
          },
          "failure_outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["review_stage_failure"]
            },
            "uniqueItems": true
          },
          "protocol_artifacts": {"$ref": "#/$defs/protocol_artifacts"}
        }
      }
    }
  }
}